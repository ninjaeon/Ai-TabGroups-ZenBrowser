[
  {
    "type": "separator",
    "label": "Feature Toggles",
    "id": "toggles-seperator"
  },
  {
    "property": "extensions.tabgroups.enable_sort",
    "label": "Enable the sort tabs button.",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "extensions.tabgroups.enable_clear",
    "label": "Enable the clear tabs button.",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "extensions.tabgroups.enable_context_menu",
    "label": "Enable the sort tabs context menu item.",
    "type": "checkbox",
    "defaultValue": true,
    "restart": true
  },
  {
    "property": "extensions.tabgroups.ai_model",
    "label": "Choose AI - Gemini, Ollama, or Mistral",
    "type": "dropdown",
    "placeholder": false,
    "value": "number",
    "default": 5,
    "options": [
      {
        "value": 1,
        "label": "Gemini"
      },
      {
        "value": 2,
        "label": "Ollama"
      },
      {
        "value": 3,
        "label": "Mistral"
      },
      {
        "value": 4,
        "label": "OpenAI-Compatible"
      },
      {
        "value": 5,
        "label": "Built-in AI (Firefox Local)"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ]
  },
  {
    "property": "extensions.tabgroups.auto_sort",
    "label": "Auto-sort tabs when they are opened or updated.",
    "type": "checkbox",
    "defaultValue": false
  },
  {
    "property": "extensions.tabgroups.resort_existing_groups",
    "label": "Resort existing tab groups when sort button is clicked (dissolves and re-sorts all groups).",
    "type": "checkbox",
    "defaultValue": false,
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ]
  },
  {
    "type": "separator",
    "label": "Gemini",
    "id": "gemini-separator",
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.ai_model",
          "value": 1
        }
      },
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "property": "extensions.tabgroups.gemini_api_key",
    "label": "Gemini API Key",
    "type": "string",
    "placeholder": "Enter your Gemini API key here",
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.ai_model",
          "value": 1
        }
      },
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "property": "extensions.tabgroups.gemini_model",
    "label": "Gemini Model to Use For Renaming",
    "default": "gemini-2.0-flash",
    "type": "string",
    "placeholder": "Enter your Gemini Model here",
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.ai_model",
          "value": 1
        }
      },
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "separator",
    "label": "Ollama",
    "id": "ollama-separator",
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.ai_model",
          "value": 2
        }
      },
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "property": "extensions.tabgroups.ollama_endpoint",
    "label": "Ollama Endpoint URL",
    "default": "http://localhost:11434/api/generate",
    "type": "string",
    "placeholder": "Enter your Ollama Endpoint URL here",
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.ai_model",
          "value": 2
        }
      },
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "property": "extensions.tabgroups.ollama_model",
    "label": "Ollama Model to Use For Renaming",
    "default": "llama3.1:latest",
    "type": "string",
    "placeholder": "Enter your Ollama Model here",
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.ai_model",
          "value": 2
        }
      },
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "separator",
    "label": "Mistral",
    "id": "mistral-separator",
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.ai_model",
          "value": 3
        }
      },
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "property": "extensions.tabgroups.mistral_api_key",
    "label": "Mistral API Key",
    "type": "string",
    "placeholder": "Enter your Mistral API key here",
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.ai_model",
          "value": 3
        }
      },
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "separator",
    "label": "OpenAI-Compatible",
    "id": "openai-separator",
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.ai_model",
          "value": 4
        }
      },
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "property": "extensions.tabgroups.openai_endpoint",
    "label": "OpenAI-Compatible Endpoint URL",
    "default": "https://api.openai.com/v1/chat/completions",
    "type": "string",
    "placeholder": "Enter your OpenAI-Compatible endpoint URL here",
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.ai_model",
          "value": 4
        }
      },
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "property": "extensions.tabgroups.openai_api_key",
    "label": "OpenAI-Compatible API Key",
    "type": "string",
    "placeholder": "Enter your OpenAI-Compatible API key here",
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.ai_model",
          "value": 4
        }
      },
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "property": "extensions.tabgroups.openai_model",
    "label": "OpenAI-Compatible Model to Use For Renaming",
    "default": "gpt-4o-mini",
    "type": "string",
    "placeholder": "Enter your OpenAI-Compatible model here",
    "conditions": [
      {
        "if": {
          "property": "extensions.tabgroups.ai_model",
          "value": 4
        }
      },
      {
        "if": {
          "property": "extensions.tabgroups.enable_sort",
          "value": true
        }
      }
    ],
    "operator": "AND"
  }
]
